{
  "name": "reentry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "vitest run --config vitest.validation.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Cardiac arrhythmia on a grid: Fenton-Karma reentry, fibrillation, scar and defibrillation in WebGL2",
  "license": "MIT"
}
